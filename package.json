{
  "name": "dsh-plugin-labels",
  "version": "0.9.1",
  "type": "module",
  "license": "MIT",
  "description": "Chinese names and one-line explanations for installed DSH plugins; automatic translation and in-place display on the official Plugins page.",
  "author": "qyy2005",
  "homepage": "https://github.com/qyy2005/dsh-plugin-labels#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qyy2005/dsh-plugin-labels.git"
  },
  "bugs": {
    "url": "https://github.com/qyy2005/dsh-plugin-labels/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "dsh-plugin",
    "labels",
    "chinese",
    "localization"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts/gen-doc.mjs"
  ],
  "scripts": {
    "docs": "node scripts/gen-doc.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
